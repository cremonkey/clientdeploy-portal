APP_NAME="ClientDeploy Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

APP_URL=http://localhost:8088
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Comma-separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public URL for the API (used by docker-compose to bake into the frontend build)
NEXT_PUBLIC_API_URL=http://localhost:8088/api

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clientdeploy
DB_USERNAME=clientdeploy
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=error

COOLIFY_BASE_URL=https://your-coolify-server:8000
COOLIFY_API_TOKEN=
COOLIFY_WEBHOOK_SECRET=
COOLIFY_WEBHOOK_ALLOWED_IPS=

DEPLOY_RATE_LIMIT=5

REVERB_APP_ID=clientdeploy
REVERB_APP_KEY=clientdeploy-key
REVERB_APP_SECRET=clientdeploy-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
